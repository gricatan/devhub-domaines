# Copie ce fichier en .env.local pour le developpement.
#
# Tu n'en as PAS besoin pour utiliser l'application : elle te demande ton jeton
# dans l'interface et le range dans le coffre chiffre du systeme.
#
# .env.local n'est lu qu'en developpement. Une application packagee ne le
# cherche meme pas (garde-fou `app.isPackaged` dans src/coeur/secrets.js).

# Jeton d'API Cloudflare - evite de le ressaisir a chaque lancement.
CF_API_TOKEN=

# Identifiant de compte Cloudflare - utile seulement si ton jeton est
# restreint a certaines zones et ne peut pas lister les comptes.
CF_ACCOUNT_ID=

# Client OAuth Cloudflare (methode d'authentification « none », PKCE).
# Sans lui, l'application masque la connexion OAuth et propose le jeton.
CF_OAUTH_CLIENT_ID=
